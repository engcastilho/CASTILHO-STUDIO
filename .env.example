# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings → Environment Variables).

# Domínio definitivo do site (sem barra no final). Na Vercel, se vazio, usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# WhatsApp no formato internacional, só dígitos (55 + DDD + número). Tem prioridade sobre src/config/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=5519999999999
